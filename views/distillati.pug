extends menu.pug

mixin menu_distillati(array)
    -for(let index=0;index<array.length;index++){
        article(class="w-full py-3")
            header(class="w-full pb-4")
                // ✅ Legge direttamente i campi vtn-backend
                h1(class="font-nunito text-left text-arancio font-extralight text-2xl lg:text-4xl")=array[index].tipologia.nome
                if array[index].tipologia.descrizione
                    p(class="font-nunito text-left text-marrone-400 font-light text-sm lg:text-base mt-2")=array[index].tipologia.descrizione
            -for(let j=0;j<array[index].liquori.length;j++){
                
                div(class="w-full pb-4")  
                    div(class="flex items-start justify-between")
                        div(class="grow pr-3")
                            div(class="flex items-start justify-between")
                                // ✅ Campi vtn-backend diretti
                                h3(class="font-nunito font-medium text-marrone-400 text-base lg:text-xl")=array[index].liquori[j].nome || array[index].liquori[j].name
                                div(class="ml-4 flex flex-col items-end")
                                    if array[index].liquori[j].disponibile === false
                                        span(class="text-xs text-orange-500 font-medium bg-orange-100 px-2 py-1 rounded mb-1") Non disponibile
                                    else if array[index].liquori[j].attivo === false || array[index].liquori[j].nascondi === true
                                        span(class="text-xs text-gray-500 font-medium bg-gray-100 px-2 py-1 rounded mb-1") Temporaneamente non disponibile
                                    else if array[index].liquori[j].novita === true
                                        span(class="text-xs text-green-500 font-medium bg-green-100 px-2 py-1 rounded mb-1") Novità!
                            // ✅ Informazioni del liquore in una riga separata da " • " (descrizione prima)
                            -const infoLiquore = []
                            -if(array[index].liquori[j].descrizione) infoLiquore.push(array[index].liquori[j].descrizione)
                            -if(array[index].liquori[j].grado) infoLiquore.push(array[index].liquori[j].grado)
                            -if(array[index].liquori[j].capacita) infoLiquore.push(array[index].liquori[j].capacita)
                            -if(array[index].liquori[j].invecchiamento) infoLiquore.push(array[index].liquori[j].invecchiamento)
                            -if(array[index].liquori[j].nazione) infoLiquore.push(array[index].liquori[j].nazione.nome)
                            
                            if infoLiquore.length > 0
                                div(class="mt-2")
                                    p(class="font-nunito font-light text-grigio-300 text-xs lg:text-sm")=infoLiquore.join(' • ')
                        div(class="flex-none ml-4")
                            div(class="text-right")
                                if array[index].liquori[j].prezzoCalice
                                    p(class="font-nunito text-right text-nero font-semibold text-base lg:text-lg")=(array[index].liquori[j].prezzoCalice)+'€' + ' ' + (array[index].liquori[j].prezzo || array[index].liquori[j].price)+'€'
                                else
                                    p(class="font-nunito text-right text-nero font-semibold text-base lg:text-lg")=(array[index].liquori[j].prezzo || array[index].liquori[j].price)+'€'
            -}     
            
    -}

block content
    main(class="w-full px-4 md:w-[48rem] lg:w-[56rem] md:mx-auto")
        nav(class="w-full grid-rows-6 pt-4")
            a(href="/" class="")
                p(class="font-nunito text-left text-marrone-400 font-extralight text-2xl lg:text-4xl") < Indietro
        section(class="w-full grid-rows-6 py-9")
            div(class="w-full py-3")
                div(class="w-full grid grid-cols-12 gap-0 h-12 border-marrone-100 border-b")
                    figure(class="col-span-2 pr-2")!=result.pagina.icon
                    div(class="col-span-10")
                        p(class="font-nunito text-left text-marrone-400 font-extralight text-2xl lg:text-4xl")=result.pagina.label
            +menu_distillati(result.menu)