extends menu.pug

mixin menu_piatti(array)
    -for(let index=0;index<array.length;index++){
        article(class="w-full py-3")
            header(class="w-full pb-4")
                // ✅ Legge direttamente i campi vtn-backend
                h1(class="font-nunito text-left text-arancio font-extralight text-2xl lg:text-4xl")=array[index].nome || array[index].nome_sezione || array[index].categoria
                if array[index].descrizione
                    p(class="font-nunito text-left text-marrone-400 font-light text-sm lg:text-base mt-2")=array[index].descrizione
            -for(let j=0;j<array[index].piatti.length;j++){
                
                div(class="w-full pb-3 mb-8 border-b border-gray-200 last:border-b-0")  
                    div(class="flex items-start justify-between")
                        div(class="grow pr-3")
                            div(class="flex items-start justify-between")
                                // ✅ Campi vtn-backend diretti
                                h3(class="font-nunito font-medium text-marrone-400 text-base lg:text-xl")=array[index].piatti[j].nome || array[index].piatti[j].name
                                div(class="ml-4 flex flex-col items-end")
                                    if array[index].piatti[j].disponibile === false
                                        span(class="text-xs text-orange-500 font-medium bg-orange-100 px-2 py-1 rounded mb-1") Non disponibile
                                    else if array[index].piatti[j].attivo === false || array[index].piatti[j].nascondi === true
                                        span(class="text-xs text-gray-500 font-medium bg-gray-100 px-2 py-1 rounded mb-1") Temporaneamente non disponibile
                                    else if array[index].piatti[j].novita === true
                                        span(class="text-xs text-green-500 font-medium bg-green-100 px-2 py-1 rounded mb-1") Novità!
                            p(class="font-nunito font-light text-grigio-200 text-xs lg:text-base mt-1")=array[index].piatti[j].descrizione || array[index].piatti[j].description
                            
                            // ✅ Badge per caratteristiche del piatto (estratte dalla descrizione)
                            -const descrizione = (array[index].piatti[j].descrizione || '').toLowerCase()
                            -const isGlutenFree = descrizione.includes('gluten free') || array[index].piatti[j].glutenFree === true
                            -const isNoLatticini = descrizione.includes('no latticini') || array[index].piatti[j].noLatticini === true
                            -const isVegan = descrizione.includes('vegan') || array[index].piatti[j].vegan === true
                            
                            // ✅ Badge per caratteristiche del piatto - Separati con più spazio
                            div(class="mt-4 mb-6 flex flex-wrap gap-2")
                                if isGlutenFree
                                    span(class="inline-flex items-center rounded-md bg-green-50 px-3 py-1.5 text-xs font-medium text-green-800 ring-1 ring-inset ring-green-600/20") Gluten Free
                                if isNoLatticini
                                    span(class="inline-flex items-center rounded-md bg-blue-50 px-3 py-1.5 text-xs font-medium text-blue-800 ring-1 ring-inset ring-blue-600/20") No Latticini
                                if isVegan
                                    span(class="inline-flex items-center rounded-md bg-purple-50 px-3 py-1.5 text-xs font-medium text-purple-800 ring-1 ring-inset ring-purple-600/20") Vegan
                            
                            // ✅ Allergeni come badge - Stile precedente con linea separatrice
                            if array[index].piatti[j].allergeni && array[index].piatti[j].allergeni.length > 0
                                div(class="mt-6 mb-4")
                                    span(class="text-xs text-gray-600 font-medium mb-2 block") Allergeni:
                                    div(class="flex flex-wrap gap-1")
                                        -for(let k=0;k<array[index].piatti[j].allergeni.length;k++){
                                            span(class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-800 ring-1 ring-inset ring-red-600/20")=array[index].piatti[j].allergeni[k].nome
                                        -}
                                    div(class="w-full mt-4")
                            
                            if array[index].piatti[j].categoria
                                div(class="mt-1")
                                    span(class="text-xs text-blue-500 font-medium") 🍽️ Categoria: 
                                    span(class="text-xs text-blue-500")=array[index].piatti[j].categoria
                            
                            if array[index].piatti[j].ingredienti && array[index].piatti[j].ingredienti.length > 0
                                div(class="mt-1")
                                    span(class="text-xs text-green-500 font-medium") 🥘 Ingredienti: 
                                    span(class="text-xs text-green-500")=array[index].piatti[j].ingredienti.join(', ')
                            
                            if array[index].piatti[j].note_chef
                                div(class="mt-1")
                                    span(class="text-xs text-purple-500 font-medium") 👨‍🍳 Note Chef: 
                                    span(class="text-xs text-purple-500")=array[index].piatti[j].note_chef
                            
                            if array[index].piatti[j].preparazione
                                div(class="mt-1")
                                    span(class="text-xs text-indigo-500 font-medium") ⏱️ Preparazione: 
                                    span(class="text-xs text-indigo-500")=array[index].piatti[j].preparazione
                        div(class="flex-none ml-4")
                            p(class="font-nunito text-left text-nero font-semibold text-base lg:text-lg")=(array[index].piatti[j].prezzo || array[index].piatti[j].price)+'€'
            -}     
            
    -}

block content
    main(class="w-full px-4 md:w-[48rem] lg:w-[56rem] md:mx-auto")
        nav(class="w-full grid-rows-6 pt-4")
            a(href=(result.backUrl || '/') class="")
                p(class="font-nunito text-left text-marrone-400 font-extralight text-2xl lg:text-4xl") < Indietro
        section(class="w-full grid-rows-6 py-9")
            div(class="w-full py-3")
                div(class="w-full grid grid-cols-12 gap-0 h-12 border-marrone-100 border-b")
                    figure(class="col-span-2 pr-2")!=result.pagina.icon
                    div(class="col-span-10")
                        p(class="font-nunito text-left text-marrone-400 font-extralight text-2xl lg:text-4xl")=result.pagina.label
            +menu_piatti(result.menu)
