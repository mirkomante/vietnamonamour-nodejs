extends menu.pug

mixin menu_degustazione(array)
        -for(let index=0;index<array.length;index++){
            article(class="w-full py-6 pt-8 mb-8")
                header(class="w-full pb-4")
                    // ✅ Legge direttamente i campi vtn-backend
                    h1(class="font-nunito text-left text-arancio font-extralight text-2xl lg:text-4xl")=array[index].nome || array[index].title
                div(class="w-full flex items-center h-8")  
                    div(class="grow")
                        p(class="font-nunito text-left text-marrone-400 font-extralight text-sm lg:text-base")=array[index].descrizione || array[index].description
                    div(class="flex-none")
                        p(class="font-nunito text-left text-nero font-semibold text-base lg:text-lg")=(array[index].prezzo || array[index].price)+'€'
                
                // ✅ Gestisce sia vtn-backend che fallback
                -const piatti = array[index].piatti || array[index].item || []
                -for(let j=0;j<piatti.length;j++){
                    div(class="w-full pl-2 py-2")
                        div(class="flex items-start justify-between")
                            div(class="flex-1")
                                // ✅ Campi vtn-backend diretti
                                h3(class="font-nunito font-medium text-marrone-400 text-base lg:text-xl")=piatti[j].nome || piatti[j].piatto || piatti[j].name
                                p(class="font-nunito font-light text-grigio-200 text-xs lg:text-base")=piatti[j].descrizione || piatti[j].description
                                
                                // ✅ Badge per caratteristiche del piatto
                                div(class="mt-4 mb-3 flex flex-wrap gap-2")
                                    if piatti[j].glutenFree === true
                                        span(class="inline-flex items-center rounded-md bg-green-50 px-3 py-1.5 text-xs font-medium text-green-800 ring-1 ring-inset ring-green-600/20") Gluten Free
                                    if piatti[j].noLatticini === true
                                        span(class="inline-flex items-center rounded-md bg-blue-50 px-3 py-1.5 text-xs font-medium text-blue-800 ring-1 ring-inset ring-blue-600/20") No Latticini
                                    if piatti[j].vegan === true
                                        span(class="inline-flex items-center rounded-md bg-purple-50 px-3 py-1.5 text-xs font-medium text-purple-800 ring-1 ring-inset ring-purple-600/20") Vegan
                                
                                // ✅ Tutti i nuovi campi vtn-backend
                                if piatti[j].allergeni && piatti[j].allergeni.length > 0
                                    div(class="mt-6 mb-4")
                                        span(class="text-xs text-gray-600 font-medium mb-2 block") Allergeni:
                                        div(class="flex flex-wrap gap-1")
                                            -for(let k=0;k<piatti[j].allergeni.length;k++){
                                                span(class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-800 ring-1 ring-inset ring-red-600/20")=piatti[j].allergeni[k].nome
                                            -}
                                        div(class="w-full mt-4")
                                
                                if piatti[j].categoria
                                    div(class="mt-1")
                                        span(class="text-xs text-blue-500 font-medium") 📂 Categoria: 
                                        span(class="text-xs text-blue-500")=piatti[j].categoria
                                
                                if piatti[j].ingredienti && piatti[j].ingredienti.length > 0
                                    div(class="mt-1")
                                        span(class="text-xs text-green-500 font-medium") 🥘 Ingredienti: 
                                        span(class="text-xs text-green-500")=piatti[j].ingredienti.join(', ')
                                
                                if piatti[j].note_chef
                                    div(class="mt-1")
                                        span(class="text-xs text-purple-500 font-medium") 👨‍🍳 Note Chef: 
                                        span(class="text-xs text-purple-500")=piatti[j].note_chef
                            div(class="ml-4 flex flex-col items-end")
                                // ✅ Gestione disponibilità vtn-backend
                                if piatti[j].disponibile === false
                                    span(class="text-xs text-orange-500 font-medium bg-orange-100 px-2 py-1 rounded") Non disponibile
                                else if piatti[j].attivo === false || piatti[j].nascondi === true
                                    span(class="text-xs text-gray-500 font-medium bg-gray-100 px-2 py-1 rounded") Temporaneamente non disponibile
                                else if piatti[j].novita === true
                                    span(class="text-xs text-green-500 font-medium bg-green-100 px-2 py-1 rounded") Novità!
                -}
                
                // ✅ Sezione allergeni del menù (dopo i piatti)
                if array[index].allergeni && array[index].allergeni.length > 0
                    div(class="w-full pl-2 pt-4 mt-6")
                        div(class="flex items-center mb-3")
                            span(class="text-sm font-medium text-marrone-400") Allergeni presenti nel menù:
                        div(class="flex flex-wrap gap-2")
                            -for(let k=0;k<array[index].allergeni.length;k++){
                                span(class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-800 ring-1 ring-inset ring-red-600/20")=array[index].allergeni[k].nome
                            -}
                        div(class="w-full border-b border-gray-200 mt-4")
                
        -}

block content
    main(class="w-full px-4 md:w-[48rem] lg:w-[56rem] md:mx-auto")
        nav(class="w-full grid-rows-6 pt-4")
            a(href="/" class="")
                p(class="font-nunito text-left text-marrone-400 font-extralight text-2xl lg:text-4xl") < Indietro
        section(class="w-full grid-rows-6 py-9")
            div(class="w-full py-3")
                div(class="w-full grid grid-cols-12 gap-0 border-marrone-100 border-b")
                    figure(class="col-span-2 pr-2")!=result.pagina.icon
                    div(class="col-span-10")
                        p(class="font-nunito text-left text-marrone-400 font-extralight text-2xl lg:text-4xl")=result.pagina.label
                        if result.pagina.descrizione
                            p(class="font-nunito text-left text-marrone-400 font-light text-sm lg:text-base mt-2 pb-4")=result.pagina.descrizione
                        else
                            div(class="pb-4")
            +menu_degustazione(result.menu)
            