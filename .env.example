# Configurazione per Vietnamonamour
# Copia questo file in .env e modifica i valori per il tuo ambiente

# Ambiente (development, production, test)
NODE_ENV=development

# Porta del server
PORT=3000

# URL base per i file statici
FILE_PATH=http://localhost:3000/

# URL del backend VTN (obbligatorio in produzione)
VTN_BACKEND_URL=http://localhost:8080

# Timeout per le chiamate API (in millisecondi)
API_TIMEOUT=10000

# Livello di log (debug, info, warn, error, silent)
LOG_LEVEL=debug

# ID delle categorie VTN Backend (opzionali, hanno valori di default)
DEGUSTAZIONE_CATEGORY_ID=b1d71cbe-9fdf-4f1e-ac1b-6974284d44c7
BUSINESS_LUNCH_CATEGORY_ID=49c6b34c-ede2-4cc9-8ed2-5a34ea6e044c
PIATTI_CATEGORY_IDS=a89d1e1f-7405-4851-8b15-fe0f42a6d1db,4fbf8bc5-1271-483f-b784-43c0004eb9fb,9a2d42fc-d435-4ed0-a2e0-adb7d2ded0d2,1e66084b-0409-4d73-9fba-af177b37fd20,9e963d11-f9f5-41d9-a58c-65de284d9b16
DOLCI_CATEGORY_ID=da660752-2540-47e5-81d5-005b7f62ef6a
